{
  "name": "Seattle collision dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "remoteUser": "vscode",
  "mounts": [
    "source=${devcontainerId}-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${devcontainerId}-node-modules,target=${containerWorkspaceFolder}/frontend/node_modules,type=volume"
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "DASHBOARD_DATA_BACKEND": "artifacts"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "sudo chown vscode:vscode .venv frontend/node_modules && python -m venv .venv && .venv/bin/python -m pip install -e '.[test]' && .venv/bin/python -m backend.scripts.build_artifacts && npm --prefix frontend ci --legacy-peer-deps && npm --prefix frontend run build",
  "postStartCommand": "nohup .venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload > /tmp/dashboard-api.log 2>&1 &",
  "portsAttributes": {
    "8000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
